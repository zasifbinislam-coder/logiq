data/uploads/
data/photos/
data/parquet/*.csv
data/parquet/*.parquet
reports/*.html
reports/*.pdf
reports/*.log

# Tooling / docs / notebooks not needed at runtime
notebooks/
docs/
models/
tests/
.pytest_cache
.mypy_cache
.ruff_cache

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.tmp

# Secrets
.env
.env.*
*.pem
*.key
